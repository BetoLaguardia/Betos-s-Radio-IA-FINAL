# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BLOB_READ_WRITE_TOKEN: Vercel Blob read/write token (automatically injected when connected on Vercel).
BLOB_READ_WRITE_TOKEN=""

# ADMIN_PASSWORD: Optional custom password for Creator Admin access.
ADMIN_PASSWORD=""

# ADMIN_TOKEN_SECRET: Optional HMAC secret for signing Creator Admin tokens.
ADMIN_TOKEN_SECRET=""

# SUPABASE_URL: URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=""

# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY: Server-side secret/service key
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_PUBLISHABLE_KEY / SUPABASE_ANON_KEY: Public/anon key
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_ANON_KEY=""

# SUPABASE_JWKS_URL: Optional JWKS URL for Supabase Auth
SUPABASE_JWKS_URL=""

# Client-exposed Supabase public variables (Vite)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
